# ==============================================================================
# MERN Stack Comprehensive .gitignore
# Place this file in the root directory of your project.
# ==============================================================================

# Dependencies
# Excludes the massive packages folder for both backend and frontend
node_modules/
/client/node_modules/
/server/node_modules/
jspm_packages/
.npm/

# Environment Variables & Secrets
# NEVER commit these files to version control as they contain API keys and database strings
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Production Build Directories
# Generated folders containing optimized code for deployment
/client/build/
/client/dist/
/client/out/
build/
dist/

# Logs and Debugging
# Eliminates system runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# Testing & Coverage
# Excludes reports generated by testing frameworks like Jest or Mocha
/coverage/
.nyc_output

# IDEs, Text Editors, and System Files
# Removes editor-specific settings and operating system clutter
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS specific files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Optional: Media / Uploads folder 
# If your application stores user-uploaded files locally during development
/server/uploads/
/server/thumbnails/
