PORT=5000
# Loan applications, payments, and reversals use MongoDB transactions; configure a replica set or sharded cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/xorvest
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
ALLOW_SEED_DATA=false
# Integration tests require an isolated replica-set test database with this name prefix.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/xorvest_test?replicaSet=rs0
